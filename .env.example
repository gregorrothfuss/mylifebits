# ==============================================================================
# MyLifeBits & Timeline Studio - Environment Configuration Template
# Copy this file to .env and customize for your local environment.
# ==============================================================================

# Database Configuration
# Path to the primary SQLite database. Defaults to ./timeline.db
# (or ./timeline_viewer.db if present in the workspace root).
TIMELINE_DB_PATH=./timeline.db

# Web Server & Reverse Proxy Options
HOST=127.0.0.1
PORT=8080
TIMELINE_PUBLIC_URL=https://mylifebits.local
CORS_ALLOWED_ORIGINS=https://mylifebits.local

# User Identity, Aliases & Home Anchors
# Used when importing calendar, chat, and photo companions to avoid self-tagging.
TIMELINE_USER_NAME=Your Name
SELF_NAMES=me,myself,Your Name,yourname
TIMELINE_USER_ALIASES=me,myself

# Optional JSON array of home anchor coordinates [{"lat": 37.7749, "lng": -122.4194}]
# When unset, home anchors are inferred automatically from life_periods and TYPE_HOME places.
TIMELINE_HOME_ANCHORS_JSON=

# Contacts & Address Enrichment (Optional)
CONTACTS_VCF_PATH=./data/Contacts.vcf

# Photos & Media Integration (Optional)
PHOTOS_ENABLED=false
PREVIEWS_DIR=./data/previews
PHOTO_CACHE_DIR=~/.mylifebits/photo_cache
PHOTOS_VAULT_DB=./photos_vault.db
PHOTOS_SEARCH_URL=https://photos.local/api/search
GPHOTOS_PROFILE_DIR=~/.mylifebits/gphotos_session
GPHOTOS_INBOX_DIR=./data/photo_inbox

# Google Takeout & Location History Ingestion
TAKEOUT_DIR=~/Downloads/Takeout
TAKEOUT_ZIP=~/Downloads/Takeout.zip

# Geocoding & External Routing
HTTP_USER_AGENT=MyLifeBits/1.0 (Location Intelligence Platform)
GOOGLE_MAPS_API_KEY=

# Android On-Device Location History (ODLH) Bridge (Optional)
ADB_BIN=adb
ADB_TARGET=
ODLH_GAIA_ID=
ODLH_DATABASE_ID=1
