# ==============================================================================
# MyLifeBits & Timeline Studio - Environment Configuration Template
# Copy this file to .env and customize for your environment.
# ==============================================================================

# Database Configuration
# Path to the primary SQLite database. If omitted, defaults to ./timeline.db
# (or ./timeline_viewer.db if present).
TIMELINE_DB_PATH=./timeline.db

# Web Server Options
HOST=0.0.0.0
PORT=8080

# User Identity & Attendee Filtering
# Used when importing calendar and photo companions to avoid tagging yourself as a guest.
TIMELINE_USER_NAME=Your Name
SELF_NAMES=me,myself,Your Name,yourname

# Photos & Media Integration (Optional)
# Directory containing pre-generated photo preview thumbnails (JPEG / WebP)
PREVIEWS_DIR=./previews

# Directory for caching remote photo proxies locally
PHOTO_CACHE_DIR=~/.mylifebits/photo_cache

# Path to external photo catalog database (optional)
PHOTOS_VAULT_DB=./photos_vault.db

# Google Takeout & Location History Ingestion
# Default directory for extracted Google Takeout archives
TAKEOUT_DIR=~/Downloads/Takeout

# Path to a specific Takeout ZIP archive for batch import
TAKEOUT_ZIP=~/Downloads/Takeout.zip

# Networking & Geocoding User Agent
# Custom User-Agent string for OpenStreetMap Nominatim and OSRM routing requests
HTTP_USER_AGENT=MyLifeBits/1.0 (Location Intelligence Platform)
